properties:
  file.name:
    displayName: File
  note.created:
    displayName: Date Created
  note.title:
    displayName: Title
views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("ai-conversation")
    order:
      - title
      - created
      - file.name
    sort:
      - property: created
        direction: DESC
      - property: file.name
        direction: DESC
      - property: title
        direction: DESC
      - property: file.links
        direction: ASC
      - property: file.path
        direction: ASC
    columnSize:
      note.title: 428
      note.created: 232
      file.name: 364
